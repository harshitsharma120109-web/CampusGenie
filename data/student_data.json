    {
      "id": "asg-dsa-01",
      "title": "DSA Graph Theory & Dynamic Programming Assessment",
      "subject": "Data Structures & Algorithms",
      "subject_code": "CS-502",
      "faculty": "Dr. Sunita Rao",
      "deadline": "28 Sept 2026",
      "total_marks": 20,
      "mode": "hybrid",
      "pdf_filename": "AKGEC_CS502_DSA_Assignment_2.pdf",
      "description": "Shortest path algorithms (Dijkstra, Bellman-Ford) and 0/1 Knapsack dynamic programming.",
      "questions": [
        {
          "id": 1,
          "q": "What is the time complexity of Dijkstra's algorithm implemented with a Min-Heap / Priority Queue?",
          "options": [
            "O(V^2)",
            "O((V + E) log V)",
            "O(V * E)",
            "O(E^2)"
          ],
          "correct": 1
        },
        {
          "id": 2,
          "q": "Which algorithm is capable of detecting negative weight cycles in a directed graph?",
          "options": [
            "Dijkstra's Algorithm",
            "Prim's Algorithm",
            "Bellman-Ford Algorithm",
            "Kruskal's Algorithm"
          ],
          "correct": 2
        },
        {
          "id": 3,
          "q": "In the 0/1 Knapsack problem with N items and capacity W, what is the DP state space complexity?",
          "options": [
            "O(N * W)",
