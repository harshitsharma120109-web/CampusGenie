  "assignments": [
    {
      "id": "asg-os-01",
      "title": "OS Process Synchronization & Deadlock Semaphore Lab",
      "subject": "Operating Systems",
      "subject_code": "CS-501",
      "faculty": "Prof. R. K. Verma",
      "deadline": "25 Sept 2026",
      "total_marks": 20,
      "mode": "hybrid",
      "pdf_filename": "AKGEC_CS501_OS_Assignment_1.pdf",
      "description": "Complete process synchronization problems using counting and binary semaphores.",
      "questions": [
        {
          "id": 1,
          "q": "Which condition is NOT one of the four Coffman conditions necessary for deadlock to occur?",
          "options": [
            "Mutual Exclusion",
            "Hold and Wait",
            "Preemption Allowed",
            "Circular Wait"
          ],
          "correct": 2
        },
        {
          "id": 2,
          "q": "In Banker's Algorithm, which matrix represents the remaining resources each process needs?",
          "options": [
            "Allocation Matrix",
            "Need Matrix (Max - Allocation)",
            "Available Vector",
            "Work Matrix"
          ],
          "correct": 1
        },
        {
          "id": 3,
          "q": "What atomic operations are permitted on semaphores to prevent race conditions?",
          "options": [
            "wait() [P] and signal() [V]",
            "lock() and unlock()",
            "start() and terminate()",
            "push() and pop()"
          ],
          "correct": 0
        },
        {
          "id": 4,
          "q": "What is the primary cause of thrashing in virtual memory systems?",
          "options": [
            "Too much CPU cache",
            "Excessive page faulting requiring high disk I/O",
            "Network socket latency",
            "High RAM capacity"
          ],
          "correct": 1
        }
      ],
